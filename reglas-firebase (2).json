        ".write": "(!data.exists() && newData.exists() && root.child('resumen_publico').child(newData.child('vId').val()).exists()) || (auth != null && auth.token.email === 'sergio@yomevoy.app')",
        ".validate": "!newData.exists() || (newData.hasChildren(['vId','nombre','tel','estrellas','ts']) && (data.exists() || newData.child('ts').val() === now))",
        "vId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "destino": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "tel": {
          ".validate": "newData.isString() && newData.val().length <= 15"
        },
        "estrellas": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "texto": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "pub": {
          ".validate": "newData.isBoolean()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "$otro": {
      ".read": "$otro !== 'gestor_embarque' && $otro !== 'usuarios' && $otro !== 'usernames' && $otro !== 'presencia' && $otro !== 'registro' && $otro !== 'resumen_publico' && $otro !== 'recibos' && $otro !== 'web_publica' && $otro !== 'web_fotos' && $otro !== 'solicitudes' && $otro !== 'solicitudes_doc' && $otro !== 'clientes_app' && $otro !== 'presencia_app' && $otro !== 'vend_idx' && $otro !== 'cambios' && $otro !== 'caja' && $otro !== 'embarque_mis' && $otro !== 'espera' && $otro !== 'liquidacion' && $otro !== 'valoraciones'",
      ".write": "$otro !== 'gestor_embarque' && $otro !== 'usuarios' && $otro !== 'usernames' && $otro !== 'presencia' && $otro !== 'registro' && $otro !== 'resumen_publico' && $otro !== 'recibos' && $otro !== 'web_publica' && $otro !== 'web_fotos' && $otro !== 'solicitudes' && $otro !== 'solicitudes_doc' && $otro !== 'clientes_app' && $otro !== 'presencia_app' && $otro !== 'vend_idx' && $otro !== 'cambios' && $otro !== 'caja' && $otro !== 'embarque_mis' && $otro !== 'espera' && $otro !== 'liquidacion' && $otro !== 'valoraciones'"
    }
  }
